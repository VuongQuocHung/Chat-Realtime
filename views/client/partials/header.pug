header.site-header
  .site-header__inner
    a.site-logo(href="/") ChatNow
    nav.site-nav(aria-label="Điều hướng chính")
      a(href="/") Trang chủ
      if user
        a(href="/chat") Chat
    .site-header__actions
      if user
        span.site-user Xin chào, #{user.fullName}
        form#logout-form(action="/user/logout" method="post")
          button.button.button--ghost(type="submit") Đăng xuất
      else
        a.button.button--ghost(href="/user/login") Đăng nhập
        a.button(href="/user/register") Đăng ký
