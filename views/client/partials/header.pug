header.header
  .inner-main
    a.inner-logo(href="/") ChatNow
    nav.inner-menu(aria-label="Điều hướng chính")
      a(href="/") Trang chủ
      if user
        a(href="/chat") Chat
    .inner-actions
      if user
        span.inner-user Xin chào, #{user.fullName}
        form#logout-form(action="/user/logout" method="post")
          button.button.ghost(type="submit") Đăng xuất
      else
        a.button.ghost(href="/user/login") Đăng nhập
        a.button(href="/user/register") Đăng ký
