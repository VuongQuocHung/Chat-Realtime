extends ../../../layouts/default.pug

block main
  .chat-page
    section.chat
      .chat__header
        .chat__avatar CN
        div
          h1 Chat chung
          p Đang hoạt động

      .chat__body
        .message.message--incoming
          .message__name ChatNow
          .message__content Chào #{user.fullName}, chúc bạn có một cuộc trò chuyện vui vẻ!

        .message.message--outgoing
          .message__content Xin chào mọi người!

      form.chat__form(action="#" method="post")
        input(type="text" name="message" placeholder="Nhập nội dung..." autocomplete="off")
        button(type="button" aria-label="Gửi tin nhắn") Gửi

block scripts
  script(src="/socket.io/socket.io.js")
  script(src="/js/socket.js")
