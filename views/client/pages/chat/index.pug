extends ../../../layouts/default.pug

block main
  .chat-page
    section.chat
      .chat__header
        .chat__avatar CN
        div
          h1 Chat chung
          p Đang hoạt động

      .chat__body
        each chat in chats
          div(chat=(user.id != chat.userId ? ".message.message--incoming" : ".message.message--outgoing"))
            if(user.id != chat.userId)
              .message__name #{chat.fullName}
            .message__content #{chat.content}

      form.chat__form(action="#" method="post")
        input(type="text" name="content" placeholder="Nhập nội dung..." autocomplete="off")
        button(type="submit" aria-label="Gửi tin nhắn") Gửi

block scripts
  script(src="/socket.io/socket.io.js")
  script(src="/js/socket.js")
