extends ../../../layouts/default.pug

block main
  .chat-page
    .chat(my-id=user.id)
      .chat__header
        .chat__avatar CN
        div
          h1 Chat chung
          p Đang hoạt động

      .chat__body
        each chat in chats
          div(class=(user.id != chat.userId ? "message message--incoming" : "message message--outgoing"))
            if(user.id != chat.userId)
              .message__name #{chat.fullName}
            .message__content #{chat.content}

      form.chat__form(action="#" method="post")
        input(type="text" name="content" placeholder="Nhập nội dung..." autocomplete="off")
        span(class="button-icon") <i class="fa-regular fa-face-smile"></i>
        button(type="submit" aria-label="Gửi tin nhắn") Gửi

      div(class='tooltip' role='tooltip')
        emoji-picker(class='light')
