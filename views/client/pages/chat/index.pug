extends ../../../layouts/default.pug

block main
  .chat-page
    .chat(my-id=user.id)
      .inner-head
        .inner-avatar CN
        div
          h1 Chat chung
          p Đang hoạt động

      .inner-body
        each chat in chats
          div(class=(user.id != chat.userId ? "inner-message inner-incoming" : "inner-message inner-outgoing"))
            if(user.id != chat.userId)
              .inner-name #{chat.fullName}
            if(chat.content)
              .inner-content #{chat.content}
            if(chat.images)
              .inner-images
                each image in chat.images
                  img(src=image)

        div(class="inner-list-typing")
          //- div(class="box-typing")
          //-   div(class="inner-name") Le Van A
          //-   div(class="inner-dots")
          //-     span
          //-     span
          //-     span

      form.inner-form(action="#" method="post")
        input(type="text" name="content" placeholder="Nhập nội dung..." autocomplete="off")
        span(class="inner-button-icon") <i class="fa-regular fa-face-smile"></i>
        button(type="submit" aria-label="Gửi tin nhắn") <i class="fa-regular fa-paper-plane"></i>

      div(class="tooltip" role="tooltip")
        emoji-picker(class="light")

      .inner-preview-images
        div(class="custom-file-container" data-upload-id="upload-images")
