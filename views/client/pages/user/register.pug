extends ../../../layouts/default.pug

block main
  section.auth-page
    .auth-card
      h1 Tạo tài khoản
      p.auth-card__description Đăng ký nhanh, chưa cần xác thực email.
      form.auth-form#register-form
        label(for="fullName") Họ và tên
        input#fullName(type="text" name="fullName" placeholder="Nguyễn Văn A" autocomplete="name" required)
        label(for="email") Email
        input#email(type="email" name="email" placeholder="name@example.com" autocomplete="email" required)
        label(for="password") Mật khẩu
        input#password(type="password" name="password" minlength="6" autocomplete="new-password" required)
        label(for="passwordConfirm") Xác nhận mật khẩu
        input#passwordConfirm(type="password" name="passwordConfirm" minlength="6" autocomplete="new-password" required)
        button.button.button--full(type="submit") Đăng ký
      p.auth-card__footer Đã có tài khoản? #[a(href="/user/login") Đăng nhập]
