extends ../../layouts/default.pug

block main
  section.hero
    .inner-content
      p.inner-eyebrow CHAT REALTIME
      h1 Trò chuyện đơn giản, kết nối nhanh chóng.
      p.inner-description Đăng ký một tài khoản để bắt đầu nhắn tin trong không gian chat riêng của bạn.
      .inner-actions
        if user
          a.button.large(href="/chat") Vào chat
        else
          a.button.large(href="/user/register") Tạo tài khoản
          a.button.ghost.large(href="/user/login") Đăng nhập
    .inner-card
      .inner-dot
      .inner-message
        strong ChatNow
        span Sẵn sàng trò chuyện
      p Mọi cuộc trò chuyện đều bắt đầu bằng một lời chào.
